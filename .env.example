# =========================================================================
# Mission: Zero Noise — 환경변수 예제
# 실제 운영용은 server/.env 또는 game/.env 로 복사 후 값을 채우세요.
# =========================================================================

# --- Server ---
PORT=80

# --- Database ---
DB_PATH=./data/game.db

# --- Game ---
GAME_TIME_LIMIT=180

# --- AI 공통 (config.js default와 동기화됨) ---
AI_MAX_TOKENS=250
AI_TEMPERATURE=0.85
AI_TIMEOUT=15000
MAX_RESPONSE_LENGTH=280
# 대화 메모리 윈도우 (직전 N개 메시지만 모델에 전달, 비용·품질 균형)
CONVERSATION_WINDOW=4

# --- 운영 모드 ---
# USE_BEDROCK=1 이면 server/index_bedrock.js 진입점이 Bedrock 단독 모드로 강제
# (실패 시 Gemini 1단 fallback). 미설정이면 server/index.js 가 4단 fallback chain 사용.
USE_BEDROCK=1

# --- Admin API 인증 ---
# /api/admin/* 엔드포인트 접근 키. 미설정 시 admin 라우터 자체가 503 반환.
# 32자 이상 랜덤 문자열 권장. 예: openssl rand -hex 32
ADMIN_KEY=

# --- Amazon Bedrock (Primary in Bedrock mode) ---
# 자격증명은 EC2 IAM Role(IMDS)에서 자동. AccessKey 명시할 필요 없음.
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# --- Google Gemini (Bedrock fallback / 일반 모드 2단계) ---
# Bedrock 일시 장애 시 자동으로 호출됨. 유료 결제 후 새 키 받으면:
#   1) 이 파일 GEMINI_API_KEY 값 교체
#   2) bash scripts/start.sh 로 서버 재시작 (~1~2초 다운타임)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- Groq (일반 모드 Primary) ---
GROQ_API_KEY=your-groq-api-key-here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MODEL_FALLBACK=openai/gpt-oss-120b
GROQ_MODEL_BACKUP=llama-3.1-8b-instant

# --- Grok / xAI (일반 모드 최종 fallback) ---
GROK_BASE_URL=https://api.x.ai/v1
GROK_API_KEY=your-grok-api-key-here
GROK_MODEL=grok-3-mini
