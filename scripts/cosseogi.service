[Unit]
Description=Cosseogi (코쓱이의 비밀) — Bedrock 모드 서버
Documentation=https://github.com/Kim-seung-hyuk/cossigi
After=network-online.target
Wants=network-online.target

# 동일 분 내 5회 이상 연속 실패하면 멈춤 (무한 재시작 루프 방지).
# 주의: 이 두 키는 [Unit] 섹션에 와야 함 ([Service]에 두면 systemd가 무시).
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=root
WorkingDirectory=/home/ec2-user/game

# 한국 시간 + Bedrock 강제 모드
Environment=TZ=Asia/Seoul
Environment=USE_BEDROCK=1

# 절대 경로 — systemd는 PATH 안 봄. node 위치 바뀌면 여기 같이 수정.
ExecStart=/home/ec2-user/.nvm/versions/node/v22.21.1/bin/node server/index_bedrock.js

# 로그는 server.log 에 append (이전: nohup이 매 재시작마다 truncate → incident 분석 불가).
# 무한히 커지지는 않도록 며칠 단위 logrotate는 별도로 검토.
StandardOutput=append:/home/ec2-user/game/server.log
StandardError=append:/home/ec2-user/game/server.log

# 비정상 종료 시 자동 복구 — 축제 중 process crash / OOM kill 대비.
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
